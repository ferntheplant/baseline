// Skills copied from other repos and edited in place. Each entry records the upstream commit the
// local copy was last merged from (`base`), so `/rebaseline skills` can tell a local edit from an
// upstream change and three-way merge one into the other. A skill in `.agents/skills/` with no
// entry here is this repo's own.
//
// Every local edit gets a comment on its entry saying what changed and why: the next merge reads
// those comments to decide which side of a conflict to keep. An edit with no comment reads as
// drift, and the merge is free to take upstream's version over it.
{
  "sources": {
    "mattpocock": {
      "repo": "https://github.com/mattpocock/skills",
      "ref": "main",
      "license": ".agents/licenses/mattpocock-skills.txt",
    },
    "explain-diff-html": {
      "repo": "https://github.com/malav2110/explain-diff-html",
      "ref": "main",
      "license": ".agents/licenses/explain-diff-html.txt",
    },
    "agent-browser": {
      "repo": "https://github.com/vercel-labs/agent-browser",
      "ref": "main",
      "license": ".agents/licenses/agent-browser.txt",
    },
  },
  // Keyed by the skill's directory under `.agents/skills/`.
  "skills": {
    "agent-browser": {
      "source": "agent-browser",
      "path": "skills/agent-browser",
      "base": "4b0e9f01fa8d214d39bbfe5391257640634fb9a0",
      // Local: the description says when to reach for it (checking a change in a browser) instead
      // of listing upstream's every use; `mise.toml` installs the CLI, so the install line says
      // so; the "Why agent-browser" sales pitch is cut.
    },
    "codebase-design": {
      "source": "mattpocock",
      "path": "skills/engineering/codebase-design",
      "base": "4ae2317ddb22b046e26455e4f9c9b3aaaf62212d",
      // Local: names the project's vocabulary file `CONTEXT.md`, this repo's convention (AGENTS.md),
      // where upstream renamed it `GLOSSARY.md`.
    },
    "explain-diff": {
      "source": "explain-diff-html",
      "path": "skills/explain-diff-html",
      "base": "407d90d24843ca42e129fb5077591d19f7483f6f",
      // Local: renamed `explain-diff` (the directory and `name`), and user-invoked
      // (`disable-model-invocation: true`), since an explainer is asked for by hand.
      // `agents/openai.yaml` is this repo's own, keeping it user-invoked in Codex too.
    },
    "grilling": {
      "source": "mattpocock",
      "path": "skills/productivity/grilling",
      "base": "4ae2317ddb22b046e26455e4f9c9b3aaaf62212d",
    },
    "pr": {
      "source": "mattpocock",
      "path": "skills/engineering/pr",
      "base": "49dd158d1076134a641b33efb035946536778336",
      // Local: Blast Radius is named in "a few words", the widest impact, not one word; evidence
      // shows the exact test, with pseudocode only when no specific test applies; the vocabulary
      // file is `CONTEXT.md`, this repo's convention, where upstream renamed it `GLOSSARY.md`.
    },
    "prototype": {
      "source": "mattpocock",
      "path": "skills/engineering/prototype",
      "base": "49dd158d1076134a641b33efb035946536778336",
      // Local: rewritten to state rules positively (the anti-pattern lists are gone, folded into
      // the rules they negated), and a UI prototype runs as `vp run <name>`, a `package.json`
      // script, per this repo's AGENTS.md.
    },
    "research": {
      "source": "mattpocock",
      "path": "skills/engineering/research",
      "base": "4ae2317ddb22b046e26455e4f9c9b3aaaf62212d",
      // Local: notes go to `RESEARCH-<topic>.md` at the repo root, a deliberate placeholder until
      // someone folds them into the real docs, and the agent reports the path back.
    },
    "wizard": {
      "source": "mattpocock",
      "path": "skills/engineering/wizard",
      "base": "49dd158d1076134a641b33efb035946536778336",
      // Local: one comment in `template.sh` reworded ("names of the secrets set this run").
    },
    "writing-for-agents": {
      "source": "mattpocock",
      "path": "skills/productivity/writing-for-agents",
      "base": "49dd158d1076134a641b33efb035946536778336",
    },
  },
}
