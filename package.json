{
  "name": "@baseline/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "sherif && typos && vp check && vp run -r test && vp run -r build && vp exec fallow",
    "prepare": "node scripts/link-agents.mjs && vp config",
    "test": "vp test run --reporter=minimal --dir scripts"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "fallow": "catalog:",
    "sherif": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.8.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "sherif": {
    "failOnWarnings": true,
    "ignoreRule": [
      "non-existant-packages"
    ]
  }
}
